# Copy to server/.env (never commit real values). All values below are placeholders.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Mapepire server on IBM i
MAPEPIRE_HOST=ibmi.example.com
MAPEPIRE_PORT=8076
MAPEPIRE_REJECT_UNAUTHORIZED=true
# MAPEPIRE_CA_FILE=/path/to/mapepire-ca.pem
IBMI_DISPLAY_NAME=IBM i (development)

# Least-privilege, read-only reporting profile
REPORT_DB_USER=QFREPORT
REPORT_DB_PASSWORD=change-me
# REPORT_DEFAULT_SCHEMA=MYLIB
# REPORT_LIBRARIES=MYLIB,MYLIB2
REPORT_NAMING=sql

# Application metadata profile (owns META_SCHEMA objects)
META_DB_USER=QFAPP
META_DB_PASSWORD=change-me
META_SCHEMA=QFMETA
META_POOL_SIZE=2

# Limits
QUERY_TIMEOUT_MS=60000
CONNECT_TIMEOUT_MS=15000
MAX_RESULT_ROWS=50000
# Server-side paging (each open cursor holds one Mapepire job)
RESULT_PAGE_SIZE=500
CURSOR_IDLE_TTL_MS=120000
CURSOR_MAX_LIFETIME_MS=600000
MAX_OPEN_CURSORS=8
MAX_OPEN_CURSORS_PER_USER=2
MAX_EXPORT_ROWS=100000
FETCH_BATCH_SIZE=500
MAX_CONCURRENT_EXECUTIONS=4
MAX_QUERY_LENGTH=32000
# Report Builder: in-memory cache for QSYS2 catalog reads (0 disables)
CATALOG_CACHE_TTL_MS=60000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
EXECUTE_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10

# Sessions: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=480
# COOKIE_SECURE=true   # defaults to true when NODE_ENV=production

# Extra schemas users may not query (META_SCHEMA is always protected)
# PROTECTED_SCHEMAS=QSYS2PRIV
XLSX_FORMULA_ESCAPE=prefix

# ---- Sign-in methods (optional) ----
AUTH_LOCAL_ENABLED=true
# OIDC (all of issuer, client id and redirect uri together; https in production)
# OIDC_ISSUER_URL=https://login.example.com/realms/corp
# OIDC_CLIENT_ID=queryforge
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=https://queryforge.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_GROUPS_CLAIM=groups
# OIDC_LABEL=Company SSO
# LDAP / Active Directory (ldaps:// or STARTTLS required in production)
# LDAP_URL=ldaps://dc1.example.com:636
# LDAP_STARTTLS=false
# LDAP_REJECT_UNAUTHORIZED=true
# LDAP_CA_FILE=/path/to/ad-ca.pem
# LDAP_BIND_DN=CN=svc-queryforge,OU=Service,DC=example,DC=com
# LDAP_BIND_PASSWORD=change-me
# LDAP_SEARCH_BASE=OU=Users,DC=example,DC=com
# LDAP_USER_FILTER=(sAMAccountName={{username}})
# LDAP_GROUP_ATTRIBUTE=memberOf
# LDAP_LABEL=Company directory
# Map external groups to app groups (case-insensitive); only mapped groups are kept
# GROUP_MAP=QF-Finance=finance;CN=QF Sales,OU=Groups,DC=example,DC=com=sales;QF-Admins=qf-admins
# ADMIN_GROUPS=qf-admins

# ---- Scheduled XLSX e-mail (optional) ----
SCHEDULER_ENABLED=false
# SCHEDULER_POLL_MS=30000
# SCHEDULER_LEASE_MS=120000
# SCHEDULE_MAX_FAILURES=3
# SCHEDULE_MIN_INTERVAL_MINUTES=15
# SCHEDULE_MAX_RECIPIENTS=20
# Exact-match domains only: example.com does NOT allow sales.example.com. Empty disables scheduled e-mail.
# SCHEDULE_RECIPIENT_DOMAINS=example.com
# SCHEDULE_DEFAULT_TIMEZONE=America/Edmonton
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # false = STARTTLS required
# SMTP_USER=queryforge
# SMTP_PASSWORD=change-me
# SMTP_FROM=QueryForge <queryforge@example.com>
# SMTP_REJECT_UNAUTHORIZED=true

# Integration tests only (never point at production)
# QF_INTEGRATION=1
