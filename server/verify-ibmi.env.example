# Uncle Bob IBM i verification kit settings. Copy to verify-ibmi.env (git-ignored) and fill in
# placeholders for a NON-PRODUCTION IBM i. Never commit real host names or passwords.
# Passwords can be left out of the file and exported in the shell instead.

# Required guard: the kit refuses to connect unless this is exactly "nonprod"
# (and --confirm-nonprod is passed on the command line).
QF_VERIFY_TARGET=nonprod

# Mapepire server on the test partition
QF_VERIFY_HOST=ibmi-test.example.invalid
QF_VERIFY_PORT=8076
QF_VERIFY_REJECT_UNAUTHORIZED=true
# QF_VERIFY_CA_FILE=./certs/mapepire-ca.pem

# Production hosts the kit must never connect to (comma-separated, optional but recommended)
QF_VERIFY_PRODUCTION_HOSTS=ibmi-prod.example.invalid

# The app's read-only reporting profile (REPORT_DB_USER in the app)
QF_VERIFY_REPORT_USER=QFREPORT
QF_VERIFY_REPORT_PASSWORD=change-me-placeholder

# Application data libraries the reporting profile must only be able to read
QF_VERIFY_DATA_LIBRARIES=SAMPLELIB

# Disposable metadata library and the profile that may create it (never QFMETA on a shared system)
QF_VERIFY_SCHEMA=UBVERIFY
QF_VERIFY_META_USER=QFAPPTEST
QF_VERIFY_META_PASSWORD=change-me-placeholder
